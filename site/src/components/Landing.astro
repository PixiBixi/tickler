---
import { Image, getImage } from "astro:assets";
import { strings, type Lang } from "../i18n";
import { latestVersion } from "../version";
import "../styles/site.css";

import liveStatus from "../../../assets/screenshots/live-status.png";
import newReminder from "../../../assets/screenshots/new-reminder.png";
import resumePrompt from "../../../assets/screenshots/resume-prompt.png";
import cropNew from "../assets/crop-new-reminder.webp";
import cropLive from "../assets/crop-live-status.webp";
import cropResume from "../assets/crop-resume-prompt.webp";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang];
const version = latestVersion();
const install = "brew install --cask pixibixi/tap/tickler";
const repo = "https://github.com/PixiBixi/tickler";
const home = lang === "en" ? "/" : "/fr/";
const otherHref = lang === "en" ? "/fr/" : "/";
const canonical = new URL(home, Astro.site);

const full = await Promise.all(
  [newReminder, liveStatus, resumePrompt].map((src) => getImage({ src, format: "webp", width: 1800 })),
);
const crops = [cropNew, cropLive, cropResume];
---
<!doctype html>
<html lang={lang} data-theme="dark" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{t.title}</title>
  <meta name="description" content={t.description}>
  <link rel="canonical" href={canonical}>
  <link rel="alternate" hreflang="en" href={new URL("/", Astro.site)}>
  <link rel="alternate" hreflang="fr" href={new URL("/fr/", Astro.site)}>
  <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta property="og:type" content="website">
  <meta property="og:title" content={t.title}>
  <meta property="og:description" content={t.description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={new URL("/og.png", Astro.site)}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#1E1B19">
  <script is:inline>try{const t=localStorage.getItem("tickler-theme");if(t)document.documentElement.dataset.theme=t}catch{}</script>
</head>
<body>
<header class="top">
  <div class="wrap">
    <a class="brand" href={home}><img src="/favicon.svg" alt="" width="26" height="26">tickler</a>
    <nav aria-label="Sections">
      <a href="#flow">{t.nav.flow}</a><a href="#cli">{t.nav.cli}</a><a href="#demo">{t.nav.demo}</a><a href="#install">{t.nav.install}</a><a href={repo}>github</a>
    </nav>
    <a class="lang" href={otherHref} hreflang={t.otherLang} lang={t.otherLang}>{t.otherLang}</a>
    <button class="icon-btn" type="button" data-theme-toggle aria-label={t.themeToggle}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></button>
  </div>
</header>

<main>
<section class="hero">
  <div class="wrap">
    <div class="grid">
      <div>
        <div class="prompt">~ $ tickler --version{version && `  # ${version}`}</div>
        <h1>{t.h1a}<br><em>{t.h1b}</em></h1>
        <p class="lede">{t.lede}</p>
        <div class="install"><code>{install}</code><button type="button" data-copy={install} data-copied={t.copied}>{t.copy}</button></div>
        <small>{t.heroMeta} <a href={repo}>{t.source}</a></small>
      </div>
      <div class="scene" data-loop role="img" aria-label={t.sceneLabel}>
        <div class="win" aria-hidden="true">
          <div class="bar"><i></i><i></i><i></i><span>~/src/api  claude</span></div>
          <pre class="term"><span class="l l1"><span class="me">&gt; </span>{t.scene.me}</span><span class="l l2"><span class="cl">● </span>{t.scene.claude1}</span><span class="l l3"><span class="cl">● </span>Bash(tickler add "Chase Alice on the review of !87"
    --when approved --link …/merge_requests/87
    --prompt "rebase and merge !87")</span><span class="l l4"><span class="ok">  ⎿ </span>fdbd8u  Chase Alice on the review of !87  Thu 09:30</span><span class="l l5"><span class="cl">● </span>{t.scene.claude2}</span></pre>
        </div>
        <div class="clock" aria-hidden="true">{t.scene.next}</div>
        <div class="toast" aria-hidden="true">
          <header><img src="/favicon.svg" alt="" width="18" height="18">TICKLER<span>now</span></header>
          <strong>Chase Alice on the review of !87</strong>
          <span class="sub">09:41 · api</span>
          <p>{t.scene.body}</p>
          <div class="acts"><span class="go">Resume Session</span><span>Open Link</span><span>Mark Done</span></div>
        </div>
        <div class="resumed" aria-hidden="true"><b>claude --resume</b> ~/src/api<br>&gt; rebase and merge !87</div>
      </div>
    </div>
    <div class="shot">
      <Image src={liveStatus} alt={t.shotAlt} widths={[900, 1800]} sizes="(max-width: 1100px) 100vw, 1100px" format="webp" loading="eager" fetchpriority="high" />
    </div>
  </div>
</section>

<section class="flow" id="flow">
  <div class="wrap">
    <div class="label">{t.flowLabel}</div>
    <h2>{t.flowTitle}</h2>
    <p class="sub">{t.flowSub}</p>
    <div class="steps">
      {t.steps.map((s, i) => (
        <div class="step reveal">
          <h3>{s.title}</h3>
          <p set:html={s.text} />
          <figure>
            <button class="zoom" type="button" data-zoom={full[i].src} aria-label={s.zoom}>
              <Image src={crops[i]} alt={s.alt} widths={[400, 780]} sizes="(max-width: 900px) 100vw, 350px" />
            </button>
            <figcaption>{s.caption}</figcaption>
          </figure>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="split" id="cli">
  <div class="wrap">
    <div>
      <div class="label">{t.cliLabel}</div>
      <h2>{t.cliTitle}</h2>
      <p class="sub">{t.cliSub}</p>
      <div class="cmds">
        {t.cmds.map(([cmd, what]) => <div><code>{cmd}</code><span set:html={what} /></div>)}
      </div>
    </div>
    <div>
      <div class="label">{t.appLabel}</div>
      <h2>{t.appTitle}</h2>
      <ul class="list">
        {t.features.map(([title, text]) => <li><div><b>{title}</b><span set:html={text} /></div></li>)}
      </ul>
    </div>
  </div>
</section>

<section class="demo" id="demo">
  <div class="wrap">
    <div class="label">{t.demoLabel}</div>
    <h2>{t.demoTitle}</h2>
    <div class="video reveal" data-video="/media/tickler-demo.mp4" data-label={t.videoLabel}>
      <img src="/media/tickler-demo-poster.webp" alt="" width="1280" height="720" loading="lazy">
      <button type="button" aria-label={t.playLabel}><span><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"/></svg>{t.play}</span></button>
    </div>
  </div>
</section>

<section class="end" id="install">
  <div class="wrap">
    <div>
      <div class="label">{t.installLabel}</div>
      <h2>{t.tagline}</h2>
    </div>
    <div>
      <div class="install"><code>{install}</code><button type="button" data-copy={install} data-copied={t.copied}>{t.copy}</button></div>
      <p set:html={t.installNote} />
    </div>
  </div>
</section>
</main>

<footer>
  <div class="wrap">
    <a href={repo}>github</a>
    <a href={`${repo}/blob/main/CHANGELOG.md`}>{t.changelog}</a>
    <a href={`${repo}/blob/main/LICENSE`}>MIT</a>
    <span class="tag">{version}</span>
  </div>
</footer>

<dialog class="lightbox"><button type="button" class="close" aria-label={t.close}>×</button><img alt=""></dialog>
<script src="../scripts/site.ts"></script>
</body>
</html>
